#!/usr/bin/env bash
# Geth: plan, approve and run nf-core analyses with LLM agents.
#
#   geth plan <data_dir> "<question>" <name>   planner agent writes a plan into runs/<name>
#   geth plan --from <run> "<question>" <name> follow-up analysis of a finished run (DE, single-cell downstream)
#   geth show <name>                           print the plan (and its automatic check)
#   geth approve <name> [--yes]                approve the plan as it is now (edit plan_* files first if needed)
#   geth run <name> [--detach]                 operator + reporter agents run the approved plan
#   geth status <name>                         outcome, report check and attempts
#   geth report <name>                         reporter agent writes the report again from the results (no rerun)
#   geth list                                  all runs and where they stand
#   geth stop <name>                           stop a planning or a run, and its scheduler jobs (geth run resumes it)
#   geth doctor                                check the installation and the site configuration
#   geth version                               print Geth's version
#   geth lab ...                               EXPERIMENTAL agent-designed analyses (not for real analyses)
source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/env.sh" || exit 1
set -euo pipefail

runs="$GETH_RUNS_DIR"
checks="$GETH_HOME/geth/bin/geth_checks.py"
source "$GETH_HOME/geth/bin/driver_slots.sh"  # GETH_MAX_DRIVERS: Nextflow drivers allowed at once here

self=$(readlink -f "${BASH_SOURCE[0]}")  # nf() changes folder: call this script back by its full path
usage() { sed -n '2,15p' "$self" | sed 's/^# \{0,1\}//'; exit 1; }
version() {  # the VERSION file, plus the commit when Geth runs from a git clone
    local commit; commit=$(git -C "$GETH_HOME" rev-parse --short HEAD 2>/dev/null || true)
    echo "Geth $(cat "$GETH_HOME/VERSION" 2>/dev/null || echo unknown)${commit:+ (commit $commit)}"
}

run_dir_of() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Run names may only use letters, digits, '.', '_' and '-'." >&2; exit 1; }
    echo "$runs/$1"
}

nf() {  # nf <run_dir> <mode> [extra args]
    local d=$1 mode=$2; shift 2
    local site=()
    [ -n "${GETH_NF_CONFIG:-}" ] && site=(-c "$GETH_NF_CONFIG")  # executor, containers: the site's
    cd "$d"
    acquire_slots "$d" "$mode" "$([ "$mode" = run ] && echo 2 || echo 1)"  # a run also starts the pipeline's driver
    local ro=() prev=
    for a in "$@"; do [ "$prev" = --upstream_run ] && ro=(--ro "$a"); prev=$a; done  # a follow-up reads its upstream run
    sandboxed "$d" "${ro[@]}" -- timeout "$(stage_limit "$mode")" nextflow run "$GETH_HOME/geth/main.nf" -c "$GETH_HOME/geth/nextflow.config" "${site[@]}" \
        --mode "$mode" --run_dir "$d" "$@" \
        -w "$d/geth_work" -with-agent-trace -with-trace "$d/geth_trace_$mode.txt" -ansi-log false \
        > "$d/geth_$mode.log" 2>&1
    local rc=$?
    explain_timeout $rc "$mode" "$d/geth_$mode.log"
    rm -f "$d/.geth_$mode.pid"
    return $rc
}

harness() {  # harness <run_dir> <stage> [args]: a stage on Geth's own agent loop (Rannoch: geth/harness, no JVM)
    local d=$1 stage=$2; shift 2
    cd "$d"
    acquire_slots "$d" "$stage" 0  # no Nextflow driver: no slot, but a pid file (geth list, geth stop)
    local ro=() prev=
    for a in "$@"; do [ "$prev" = --upstream_run ] && ro=(--ro "$a"); prev=$a; done
    sandboxed "$d" "${ro[@]}" -- timeout "$(stage_limit "$stage")" env PYTHONPATH="$GETH_HOME/geth" \
        python3 -m "harness.$stage" --run_dir "$d" "$@" > "$d/geth_$stage.log" 2>&1
    local rc=$?
    explain_timeout $rc "$stage" "$d/geth_$stage.log"
    rm -f "$d/.geth_$stage.pid"
    return $rc
}

active() {  # active <run_dir> <mode>: is a Geth driver working on this run?
    driver_alive "$1/.geth_$2.pid"
}

state() {  # one-line state of a run
    local d=$1
    if active "$d" run; then echo "running"  # also a rerun of a run that has an outcome
    elif [ -f "$d/outcome.txt" ]; then
        grep -q 'succeeded: true' "$d/outcome.txt" && echo "succeeded" || echo "failed"
    elif [ -f "$d/APPROVED" ] && [ -f "$d/geth_run.log" ]; then echo "stopped before the end (geth run resumes it)"
    elif [ -f "$d/APPROVED" ]; then echo "approved, not run yet"
    elif active "$d" plan; then echo "planning"
    elif [ -f "$d/plan_pipeline.txt" ]; then echo "planned, waiting for approval"
    elif grep -qs 'stopped by geth stop' "$d/geth_plan.log"; then echo "planning stopped"
    else echo "planning failed"
    fi
}

plan_parts() {  # extra plan parts for geth_checks.py (downstream analyses)
    local d=$1
    local f  # the second sheet: contrasts (differential expression) or multiplexed samples (scrnaseq)
    for f in plan_contrasts.csv plan_barcodes.csv; do [ -f "$d/$f" ] && printf -- '--contrasts\n%s\n' "$d/$f"; done
    [ -f "$d/plan_profile.txt" ] && printf -- '--profile\n%s\n' "$(cat "$d/plan_profile.txt")"
    [ -f "$d/plan_upstream.txt" ] && printf -- '--upstream\n%s\n' "$(cat "$d/plan_upstream.txt")"
    return 0
}

check() {
    local d=$1
    mapfile -t parts < <(plan_parts "$d")
    python3 "$checks" check-plan "$(cat "$d/plan_pipeline.txt")" "$d/plan_samplesheet.csv" "$d/plan_params.json" "${parts[@]}"
}

show() {
    local d=$1
    echo "Question : $(cat "$d/question.txt")"
    echo "Pipeline : nf-core/$(cat "$d/plan_pipeline.txt")"
    [ -f "$d/plan_upstream.txt" ] && echo "Upstream : $(cat "$d/plan_upstream.txt")"
    [ -f "$d/plan_profile.txt" ] && echo "Profile  : $(cat "$d/plan_profile.txt")"
    echo; echo "Rationale:"; sed 's/^/  /' "$d/plan_rationale.txt"
    echo; echo "Samplesheet (plan_samplesheet.csv):"
    sed "s#$GETH_DATA_ROOT/##g" "$d/plan_samplesheet.csv" | column -s, -t | sed 's/^/  /'
    if [ -f "$d/plan_contrasts.csv" ]; then
        echo; echo "Contrasts (plan_contrasts.csv):"; column -s, -t < "$d/plan_contrasts.csv" | sed 's/^/  /'
    fi
    if [ -f "$d/plan_barcodes.csv" ]; then
        echo; echo "Multiplexed samples, one row per sample of each library (plan_barcodes.csv):"
        column -s, -t < "$d/plan_barcodes.csv" | sed 's/^/  /'
    fi
    echo; echo "Parameters (plan_params.json):"; sed "s#$GETH_DATA_ROOT/##g" "$d/plan_params.json" | sed 's/^/  /'; echo
    echo; check "$d" || true
}

cmd=${1:-}; shift || true
case "$cmd" in
    plan)
        upstream_args=()
        if [ "${1:-}" = "--from" ]; then
            [ $# -eq 4 ] || usage
            up=$(run_dir_of "$2"); shift 2
            [ -f "$up/APPROVED" ] && [ -f "$up/outcome.txt" ] && grep -q 'succeeded: true' "$up/outcome.txt" \
                || { echo "Run '$(basename "$up")' has not finished successfully: nothing to build on." >&2; exit 1; }
            if [ -f "$up/data_dir.txt" ]; then
                data_dir=$(cat "$up/data_dir.txt")
            else  # runs planned before data_dir.txt existed: the folder above the FASTQ folder
                data_dir=$(dirname "$(dirname "$(python3 -c 'import csv,sys; print(next(csv.DictReader(open(sys.argv[1])))["fastq_1"])' "$up/plan_samplesheet.csv")")")
            fi
            upstream_args=(--upstream_run "$up")
        else
            [ $# -eq 3 ] || usage
            data_dir=$(readlink -f "$1"); shift
            [ -d "$data_dir" ] || { echo "No such folder: $data_dir" >&2; exit 1; }
            case "$data_dir" in
                "$GETH_DATA_ROOT"/?*) ;;
                *) echo "Agents can only read data under GETH_DATA_ROOT ($GETH_DATA_ROOT): move the data folder there," >&2
                   echo "or change GETH_DATA_ROOT in the site configuration." >&2; exit 1 ;;
            esac
        fi
        question=$1; d=$(run_dir_of "$2")
        [ -e "$d" ] && { echo "Run '$2' already exists: choose another name." >&2; exit 1; }
        mkdir -p "$d"
        echo "Planning in $d ..."
        if [ "${GETH_PLANNER:-nextflow}" = harness ]; then  # Rannoch trial: the planner on Geth's own agent loop
            harness "$d" plan --question "$question" --data_dir "$data_dir" "${upstream_args[@]}" \
                || { echo "Planning failed: see $d/geth_plan.log" >&2; exit 1; }
        else
            nf "$d" plan --question "$question" --data_dir "$data_dir" "${upstream_args[@]}" || { echo "Planning failed: see $d/geth_plan.log" >&2; exit 1; }
        fi
        show "$d"
        echo; echo "Review the plan (edit the plan_* files if needed), then: geth approve $2"
        ;;
    show)
        [ $# -eq 1 ] || usage
        show "$(run_dir_of "$1")"
        ;;
    approve)
        [ $# -ge 1 ] || usage
        d=$(run_dir_of "$1")
        show "$d"
        if ! check "$d" > /dev/null; then
            echo "The plan does not pass the plan check: fix the plan_* files, then approve." >&2
            exit 1
        fi
        if [ "${2:-}" != "--yes" ]; then
            read -r -p "Approve this plan? [y/N] " answer
            [[ "$answer" =~ ^[Yy]$ ]] || { echo "Not approved."; exit 1; }
        fi
        python3 "$checks" approve "$d" "$(whoami)"
        ;;
    run)
        [ $# -ge 1 ] || usage
        d=$(run_dir_of "$1")
        [ -f "$d/APPROVED" ] || { echo "The plan has not been approved: geth approve $1" >&2; exit 1; }
        if [ "${2:-}" = "--detach" ]; then
            # Long runs: survive the end of this shell or session.
            setsid nohup "$self" run "$1" > "$d/geth_run.out" 2>&1 < /dev/null &
            echo "Started in the background (pid $!). Follow it with: geth status $1   (log: $d/geth_run.out)"
            exit 0
        fi
        echo "Running the approved plan in $d ..."
        nf "$d" run || { echo "Geth run failed: see $d/geth_run.log" >&2; exit 1; }
        "$self" status "$1"
        ;;
    report)
        [ $# -eq 1 ] || usage
        d=$(run_dir_of "$1")
        [ -f "$d/APPROVED" ] && [ -f "$d/outcome.txt" ] || { echo "Run '$1' has not finished: nothing to report." >&2; exit 1; }
        active "$d" run && { echo "Run '$1' is running: wait for it, or geth stop $1." >&2; exit 1; }
        if [ -f "$d/report.md" ]; then  # keep the previous report
            keep="$d/report.$(date -r "$d/report.md" +%Y%m%d-%H%M%S).md"
            cp "$d/report.md" "$keep"; cp "$d/report_check.txt" "${keep%.md}.check.txt" 2>/dev/null || true
            echo "Previous report kept as $(basename "$keep")"
        fi
        echo "Writing the report again from $d/results ..."
        nf "$d" report || { echo "Report failed: see $d/geth_report.log" >&2; exit 1; }
        "$self" status "$1"
        ;;
    status)
        [ $# -eq 1 ] || usage
        d=$(run_dir_of "$1")
        [ -f "$d/outcome.txt" ] && cat "$d/outcome.txt" || echo "No outcome yet."
        [ -f "$d/report_check.txt" ] && cat "$d/report_check.txt"
        # agent_sandbox.sh leaves .agent_home in the run folder: say plainly whether the agents were contained
        [ -d "$d/.agent_home" ] && echo "agents' driver: in the agent sandbox (container)" || echo "agents' driver: not sandboxed"
        latest=$(find "$d" -maxdepth 1 -type d -name 'attempt_*' | sed 's/.*attempt_//' | sort -n | tail -n 1)
        for a in "$d"/attempt_*; do
            [ -d "$a" ] || continue
            status=$(grep -hE '^STATUS' "$a"/*.txt 2>/dev/null | head -n 1 || true)
            if [ -f "$a/STOPPED" ]; then status="stopped by geth stop (not counted)"
            elif [ "$a" = "$d/attempt_$latest" ] && active "$d" run && ! grep -qs 'Pipeline completed successfully' "$a/nextflow.log"; then
                status="running"
            elif [ -f "$a/nextflow.log" ]; then
                grep -q 'Pipeline completed successfully' "$a/nextflow.log" && status="launched: success" || status="launched: failed"
            elif [ -s "$a/gate.txt" ]; then status="refused by the plan-diff gate"
            elif [ -s "$a/check.txt" ]; then status="failed the plan check"
            fi
            echo "$(basename "$a"): ${status:-unknown}"
        done
        [ -f "$d/report.md" ] && echo "Report: $d/report.md"
        ;;
    list)
        [ $# -eq 0 ] || usage
        printf '%-24s %-22s %s\n' RUN PIPELINE STATE
        for d in "$runs"/*/; do
            d=${d%/}
            [ -f "$d/question.txt" ] || continue
            printf '%-24s %-22s %s\n' "$(basename "$d")" "$(cat "$d/plan_pipeline.txt" 2>/dev/null || echo -)" "$(state "$d")"
        done
        [ -d "$runs/lab" ] && echo "(experimental lab runs are listed by: geth lab list)"
        ;;
    stop)
        [ $# -eq 1 ] || usage
        d=$(run_dir_of "$1")
        [ -d "$d" ] || { echo "No run named '$1'." >&2; exit 1; }
        "$GETH_HOME/geth/bin/stop_driver.sh" "$d"
        [ -f "$d/APPROVED" ] && [ ! -f "$d/outcome.txt" ] && [ -f "$d/geth_run.log" ] && echo "Resume it with: geth run $1"
        exit 0
        ;;
    doctor)
        [ $# -eq 0 ] || usage
        exec "$GETH_HOME/geth/bin/geth_doctor.sh"
        ;;
    version)
        version
        ;;
    lab)
        exec "$GETH_HOME/geth/lab/lab.sh" "$@"
        ;;
    *) usage ;;
esac
