#!/usr/bin/env bash
# Geth: plan, approve and run an nf-core analysis with Qwen agents on Eddie.
#
#   geth plan <data_dir> "<question>" <name>   planner agent writes a plan into runs/<name>
#   geth plan --from <run> "<question>" <name> follow-up analysis (e.g. differential expression) of a run
#   geth show <name>                           print the plan (and its automatic check)
#   geth approve <name> [--yes]                approve the plan as it is now (edit plan_* files first if needed)
#   geth run <name> [--detach]                 operator + reporter agents run the approved plan
#   geth status <name>                         outcome, report check and attempts
set -euo pipefail
source /exports/cmvm/eddie/eb/groups/alaw3_grp/sguizard/Dev/github/Geth/env.sh

runs="$PERSEUS_VEIL/geth/runs"
checks="$GETH_HOME/geth/bin/geth_checks.py"

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

run_dir_of() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Run names may only use letters, digits, '.', '_' and '-'." >&2; exit 1; }
    echo "$runs/$1"
}

nf() {  # nf <run_dir> <mode> [extra args]
    local d=$1 mode=$2; shift 2
    cd "$d"
    nextflow run "$GETH_HOME/geth/main.nf" -c "$GETH_HOME/geth/nextflow.config" \
        --mode "$mode" --run_dir "$d" "$@" \
        -w "$d/geth_work" -with-agent-trace -with-trace "$d/geth_trace_$mode.txt" -ansi-log false \
        > "$d/geth_$mode.log" 2>&1
}

plan_parts() {  # extra plan parts for geth_checks.py (downstream analyses)
    local d=$1
    [ -f "$d/plan_contrasts.csv" ] && printf -- '--contrasts\n%s\n' "$d/plan_contrasts.csv"
    [ -f "$d/plan_profile.txt" ] && printf -- '--profile\n%s\n' "$(cat "$d/plan_profile.txt")"
    [ -f "$d/plan_upstream.txt" ] && printf -- '--upstream\n%s\n' "$(cat "$d/plan_upstream.txt")"
    return 0
}

check() {
    local d=$1
    mapfile -t parts < <(plan_parts "$d")
    python3 "$checks" check-plan "$(cat "$d/plan_pipeline.txt")" "$d/plan_samplesheet.csv" "$d/plan_params.json" "${parts[@]}"
}

show() {
    local d=$1
    echo "Question : $(cat "$d/question.txt")"
    echo "Pipeline : nf-core/$(cat "$d/plan_pipeline.txt")"
    [ -f "$d/plan_upstream.txt" ] && echo "Upstream : $(cat "$d/plan_upstream.txt")"
    [ -f "$d/plan_profile.txt" ] && echo "Profile  : $(cat "$d/plan_profile.txt")"
    echo; echo "Rationale:"; sed 's/^/  /' "$d/plan_rationale.txt"
    echo; echo "Samplesheet (plan_samplesheet.csv):"
    sed "s#$PERSEUS_VEIL/##g" "$d/plan_samplesheet.csv" | column -s, -t | sed 's/^/  /'
    if [ -f "$d/plan_contrasts.csv" ]; then
        echo; echo "Contrasts (plan_contrasts.csv):"; column -s, -t < "$d/plan_contrasts.csv" | sed 's/^/  /'
    fi
    echo; echo "Parameters (plan_params.json):"; sed "s#$PERSEUS_VEIL/##g" "$d/plan_params.json" | sed 's/^/  /'; echo
    echo; check "$d" || true
}

cmd=${1:-}; shift || true
case "$cmd" in
    plan)
        upstream_args=()
        if [ "${1:-}" = "--from" ]; then
            [ $# -eq 4 ] || usage
            up=$(run_dir_of "$2"); shift 2
            [ -f "$up/APPROVED" ] && [ -f "$up/outcome.txt" ] && grep -q 'succeeded: true' "$up/outcome.txt" \
                || { echo "Run '$(basename "$up")' has not finished successfully: nothing to build on." >&2; exit 1; }
            if [ -f "$up/data_dir.txt" ]; then
                data_dir=$(cat "$up/data_dir.txt")
            else  # runs planned before data_dir.txt existed: the folder above the FASTQ folder
                data_dir=$(dirname "$(dirname "$(python3 -c 'import csv,sys; print(next(csv.DictReader(open(sys.argv[1])))["fastq_1"])' "$up/plan_samplesheet.csv")")")
            fi
            upstream_args=(--upstream_run "$up")
        else
            [ $# -eq 3 ] || usage
            data_dir=$(readlink -f "$1"); shift
        fi
        question=$1; d=$(run_dir_of "$2")
        [ -e "$d" ] && { echo "Run '$2' already exists: choose another name." >&2; exit 1; }
        mkdir -p "$d"
        echo "Planning in $d ..."
        nf "$d" plan --question "$question" --data_dir "$data_dir" "${upstream_args[@]}" || { echo "Planning failed: see $d/geth_plan.log" >&2; exit 1; }
        show "$d"
        echo; echo "Review the plan (edit the plan_* files if needed), then: geth approve $2"
        ;;
    show)
        [ $# -eq 1 ] || usage
        show "$(run_dir_of "$1")"
        ;;
    approve)
        [ $# -ge 1 ] || usage
        d=$(run_dir_of "$1")
        show "$d"
        if ! check "$d" > /dev/null; then
            echo "The plan does not pass the plan check: fix the plan_* files, then approve." >&2
            exit 1
        fi
        if [ "${2:-}" != "--yes" ]; then
            read -r -p "Approve this plan? [y/N] " answer
            [[ "$answer" =~ ^[Yy]$ ]] || { echo "Not approved."; exit 1; }
        fi
        python3 "$checks" approve "$d" "$(whoami)"
        ;;
    run)
        [ $# -ge 1 ] || usage
        d=$(run_dir_of "$1")
        [ -f "$d/APPROVED" ] || { echo "The plan has not been approved: geth approve $1" >&2; exit 1; }
        if [ "${2:-}" = "--detach" ]; then
            # Long runs: survive the end of this shell or session.
            setsid nohup "$0" run "$1" > "$d/geth_run.out" 2>&1 < /dev/null &
            echo "Started in the background (pid $!). Follow it with: geth status $1   (log: $d/geth_run.out)"
            exit 0
        fi
        echo "Running the approved plan in $d ..."
        nf "$d" run || { echo "Geth run failed: see $d/geth_run.log" >&2; exit 1; }
        "$0" status "$1"
        ;;
    status)
        [ $# -eq 1 ] || usage
        d=$(run_dir_of "$1")
        [ -f "$d/outcome.txt" ] && cat "$d/outcome.txt" || echo "No outcome yet."
        [ -f "$d/report_check.txt" ] && cat "$d/report_check.txt"
        for a in "$d"/attempt_*; do
            [ -d "$a" ] || continue
            status=$(grep -hE '^STATUS' "$a"/*.txt 2>/dev/null | head -n 1 || true)
            if [ -f "$a/nextflow.log" ]; then
                grep -q 'Pipeline completed successfully' "$a/nextflow.log" && status="launched: success" || status="launched: failed"
            elif [ -s "$a/gate.txt" ]; then status="refused by the plan-diff gate"
            elif [ -s "$a/check.txt" ]; then status="failed the plan check"
            fi
            echo "$(basename "$a"): ${status:-unknown}"
        done
        [ -f "$d/report.md" ] && echo "Report: $d/report.md"
        ;;
    *) usage ;;
esac
