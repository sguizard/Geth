// Geth lab (EXPERIMENTAL): Geth's own settings, plus the folders the lab's tools may read.
includeConfig '../nextflow.config'

params.lab_data  = System.getenv('GETH_LAB_DATA') ?: "${System.getenv('GETH_DATA_ROOT')}/testdata"
params.lab_skill = true

// Arm B: the pinned image the agent-written steps run in (in the sandbox), and the annotation models they get.
params.lab_image   = System.getenv('GETH_LAB_IMAGE') ?: "${System.getenv('GETH_WORK_ROOT')}/geth/containers/geth_lab_sc_f4e5ea0d66d15d6c.sif"
params.lab_models  = System.getenv('GETH_LAB_MODELS') ?: "${System.getenv('GETH_REFERENCES')}/celltypist_immune_v2"
params.data_file   = null
params.build_round = 1

// Arm C: Java and Nextflow for the sandboxed driver (set by geth lab build-c), and the full run's resources.
params.lab_java_home     = null
params.lab_nxf_launcher  = null
params.lab_nxf_framework = null
params.full_cpus         = 4
params.full_memory       = 16
params.full_minutes      = 60
