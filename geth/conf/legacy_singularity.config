// Containers for older pipelines: use the singularity engine (Eddie's apptainer modules provide a `singularity`
// command) with the roslin settings. Needed when Nextflow < 23.04 has no `apptainer` scope (eager), and for
// templates that only pick the ready-made depot.galaxyproject.org images when the engine is `singularity`
// (otherwise they convert docker:// images, e.g. nanoseq 3.1.0).
apptainer.enabled = false
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B "$TMPDIR"'
    cacheDir   = System.getenv('NXF_SGE_PROJECT') ? '/exports/cmvm/eddie/eb/groups/alaw3_eb_singularity_cache' : null
}
