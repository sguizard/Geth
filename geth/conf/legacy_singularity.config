// Containers for older pipelines: use the singularity engine (apptainer installations provide a `singularity`
// command too). Needed when Nextflow < 23.04 has no `apptainer` scope (eager), and for templates that only
// pick the ready-made depot.galaxyproject.org images when the engine is `singularity` (otherwise they convert
// docker:// images, e.g. nanoseq 3.1.0). Images are cached in GETH_CONTAINER_CACHE when the site sets it.
apptainer.enabled = false
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B "$TMPDIR"'
    cacheDir   = System.getenv('GETH_CONTAINER_CACHE') ?: null
}
