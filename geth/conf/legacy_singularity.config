// Containers for pipelines run with an old Nextflow (< 23.04), which has no `apptainer` scope:
// use the singularity scope (Eddie's apptainer modules provide a `singularity` command) with the roslin settings.
singularity {
    enabled    = true
    autoMounts = true
    runOptions = '-B "$TMPDIR"'
    cacheDir   = System.getenv('NXF_SGE_PROJECT') ? '/exports/cmvm/eddie/eb/groups/alaw3_eb_singularity_cache' : null
}
