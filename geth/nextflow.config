// Geth's own Nextflow settings, for the scheduler jobs of its agents' tools (jobs.nf, lab/jobs.nf). Everything
// site-specific comes from the site configuration (loaded by env.sh) and from the site Nextflow config that the
// job launchers add with -c (GETH_NF_CONFIG). The agents themselves run in Python (geth/harness).

params.run_dir    = null
params.data_root  = System.getenv('GETH_DATA_ROOT')
params.runs_dir   = System.getenv('GETH_RUNS_DIR')
params.references = System.getenv('GETH_REFERENCES')

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h
}

trace.overwrite = true
