// Geth v1 runs on the free ELM model Qwen 3.5 only.
params.model     = 'Qwen/Qwen3.5-397B-A17B-FP8'
params.mode      = null
params.question  = null
params.data_dir  = null
params.run_dir   = null
params.data_root = '/exports/eddie/scratch/sguizard/Perseus_Veil'

// Eddie: SGE executor, apptainer, shared image cache; project from NXF_SGE_PROJECT.
includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/roslin.config'

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h
}

agent {
    runner         = 'langchain4j'
    apiProvider    = 'openai'
    baseUrl        = 'https://elm.edina.ac.uk/api/v1'
    apiKey         = System.getenv('ELM_API_KEY')
    requestTimeout = '600 sec'
}

trace.overwrite = true
