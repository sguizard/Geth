// Geth's own Nextflow settings. Everything site-specific comes from the site configuration (loaded by env.sh)
// and from the site Nextflow config that the geth command adds with -c (GETH_NF_CONFIG).

params.mode           = null
params.question       = null
params.data_dir       = null
params.run_dir        = null
params.upstream_run   = null

params.model          = System.getenv('GETH_LLM_MODEL')
params.allowed_models = System.getenv('GETH_LLM_ALLOWED_MODELS') ?: System.getenv('GETH_LLM_MODEL')
params.data_root      = System.getenv('GETH_DATA_ROOT')
params.runs_dir       = System.getenv('GETH_RUNS_DIR')
params.references     = System.getenv('GETH_REFERENCES')

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h
}

agent {
    runner         = 'langchain4j'
    apiProvider    = System.getenv('GETH_LLM_PROVIDER') ?: 'openai'
    baseUrl        = System.getenv('GETH_LLM_BASE_URL')
    apiKey         = System.getenv(System.getenv('GETH_LLM_API_KEY_VAR') ?: 'GETH_LLM_API_KEY')
    requestTimeout = '600 sec'
}

trace.overwrite = true
