# Geth site configuration — copy to site/site.env (not committed) and fill it in.
# It is sourced by env.sh (bash). Examples for real sites: site/examples/.
# Every variable is described in docs/configuration.md.

# ---------------------------------------------------------------- storage
# Geth's working area: runs, the reference catalogue and (by default) the data folders agents may read.
export GETH_WORK_ROOT=/path/to/geth_work
# Optional overrides (defaults shown):
# export GETH_DATA_ROOT=$GETH_WORK_ROOT              # agents can only list/read files below this folder
# export GETH_RUNS_DIR=$GETH_WORK_ROOT/runs          # one folder per analysis
# export GETH_REFERENCES=$GETH_WORK_ROOT/references  # reference catalogue (genomes, models, indexes)

# ---------------------------------------------------------------- language model
# Any OpenAI-compatible chat endpoint whose model supports tool (function) calling and JSON output.
export GETH_LLM_BASE_URL=https://llm.example.org/v1
export GETH_LLM_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
# Geth refuses every model not listed here (protects against paid models on a shared key).
export GETH_LLM_ALLOWED_MODELS="$GETH_LLM_MODEL"
# Name of the environment variable that holds the API key (the key itself never goes in this file).
export GETH_LLM_API_KEY_VAR=GETH_LLM_API_KEY

# ---------------------------------------------------------------- Nextflow and compute
# The Nextflow launcher must be on PATH (https://www.nextflow.io/docs/latest/install.html), e.g.:
# export PATH=/path/to/nextflow/bin:$PATH
# export GETH_NXF_VER=26.10.2                         # Nextflow version for Geth itself (>= 26.10)
# export NXF_HOME=$GETH_WORK_ROOT/nextflow            # Nextflow's cache (pipelines, plugins)

# Nextflow config for Geth's own tasks (executor, containers). Examples: site/examples/*.config
export GETH_NF_CONFIG=$GETH_HOME/site/examples/local.config
# Profile(s) given to every nf-core pipeline: an institutional profile from nf-core/configs (it sets the
# scheduler and the container engine) or a container profile such as "apptainer", "singularity" or "docker".
export GETH_NFCORE_PROFILE=apptainer
# Optional extra Nextflow config for every nf-core run (applied last):
# export GETH_NFCORE_CONFIG=/path/to/extra.config

# GPU for CellBender (nf-core/scrnaseq): "yes" adds nf-core's gpu profile; GETH_GPU_CONFIG tells your
# scheduler how to reach a GPU when it needs more than nf-core's `accelerator` directive (e.g. SGE).
export GETH_GPU=no
# export GETH_GPU_CONFIG=/path/to/gpu.config

# Pipelines pinned to an old Nextflow (nf-core/eager 2.5.3, DSL1) need Java 17:
# export GETH_JAVA17_HOME=/usr/lib/jvm/java-17-openjdk
# Image cache for pipelines run with the singularity engine (eager, nanoseq):
# export GETH_CONTAINER_CACHE=/path/to/singularity_cache

# Environment modules to load (clusters), and CPUs per Nextflow driver JVM on a shared login node.
# export GETH_MODULES="java/21 apptainer"
# export GETH_DRIVER_CPUS=2
# Nextflow drivers allowed at once on this machine (a plan uses 1, a run 2); further commands wait. 0: no limit.
# export GETH_MAX_DRIVERS=2
# Time limits for agent stages (a stuck agent must not hold the machine): planning/design/review, lab
# engineering, and a whole pipeline run.
# export GETH_AGENT_TIMEOUT=2h
# export GETH_ENGINEER_TIMEOUT=4h
# export GETH_RUN_TIMEOUT=72h

# Agents' drivers in a container (geth/bin/agent_sandbox.sh, needs apptainer): they keep the network and can
# submit jobs, but see only their run folder, its data, the reference catalogue and the folders below (rw), e.g.
# the image cache your Nextflow config uses. The API key reaches them through the environment, never a file.
# export GETH_AGENT_SANDBOX=yes
# export GETH_AGENT_SANDBOX_RW=/path/to/apptainer_cache
# export GETH_AGENT_SANDBOX_RO=/path/to/shared_databases   # read-only: databases the reference catalogue points to
# export GETH_AGENT_IMAGE=/path/to/geth_agent.sif    # Python + command-line tools; see docs/configuration.md

# Scheduler accounting, if your institutional profile needs it (e.g. the nf-core roslin profile):
# export NXF_SGE_PROJECT=my_project_code

# Optional paid planner model, opt-in per plan (geth plan ... --model sol): prices "input,cached input,output" in
# USD per million tokens, and the most one plan may spend. GPT-6 models need the Responses API for tools.
# export GETH_PLANNER_SOL_MODEL=gpt-6.1-sol
# export GETH_PLANNER_SOL_PRICES=2,0.2,10
# export GETH_PLANNER_SOL_BUDGET_USD=0.50
# export GETH_PLANNER_SOL_API=responses

# geth project: how a reference step's download (geth/references/stage_ensembl.sh) is started. Unset: on this
# machine. On a cluster, as a job where downloads are allowed, waiting for it; pass GETH_HOME only (never the whole
# environment: it holds the API key). SGE example:
# export GETH_DOWNLOAD_SUBMIT="qsub -sync y -q <transfer queue> -P <project> -cwd -j y -l h_rt=02:00:00 -v GETH_HOME=$GETH_HOME"
