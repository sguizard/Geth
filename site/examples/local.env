# Example site configuration: one workstation or server, no scheduler, apptainer containers.
# Copy to site/site.env and adapt the paths.

export GETH_WORK_ROOT=$HOME/geth_work

export GETH_LLM_BASE_URL=http://localhost:8000/v1          # e.g. a local vLLM server
export GETH_LLM_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
export GETH_LLM_ALLOWED_MODELS="$GETH_LLM_MODEL"
export GETH_LLM_API_KEY_VAR=GETH_LLM_API_KEY              # export GETH_LLM_API_KEY=... in your shell

export PATH=$HOME/.local/bin:$PATH                        # where the nextflow launcher was installed
export GETH_NF_CONFIG=$GETH_HOME/site/examples/local.config
export GETH_NFCORE_PROFILE=apptainer
export GETH_NFCORE_CONFIG=$GETH_HOME/site/examples/local-nfcore.config   # the machine's size
export GETH_GPU=no
export GETH_DRIVER_CPUS=2
