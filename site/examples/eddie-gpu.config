// GPU tasks on Eddie (SGE), used with -profile roslin,gpu when CellBender runs (GETH_GPU_CONFIG).
// nf-core marks GPU tasks with the process_gpu label and `accelerator`, which the SGE executor ignores:
// send them to the gpu queue and ask SGE for one GPU, keeping the roslin memory request and project code.
process {
    withLabel: 'process_gpu' {
        queue          = 'gpu'
        clusterOptions = {
            def memoryPerCpu = task.memory.toMega() / task.cpus
            def projectCode  = System.getenv('NXF_SGE_PROJECT') ?: 'uoe_baseline'
            "-l h_rss=${memoryPerCpu}M -l gpu=1 -P ${projectCode}"
        }
    }
}

// The nf-core gpu profile replaces the roslin apptainer options with '--nv'; keep both.
apptainer {
    runOptions = '-p --scratch /dev/shm -B "$TMPDIR" --nv'
}
