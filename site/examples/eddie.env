# Example site configuration: the University of Edinburgh's Eddie cluster (SGE), nf-core `roslin` profile,
# the University's ELM language-model gateway and GPU nodes for CellBender.
# Copy to site/site.env and replace the <...> values.

export GETH_WORK_ROOT=/exports/eddie/scratch/$USER/geth   # scratch: files older than a month are removed

export GETH_LLM_BASE_URL=https://elm.edina.ac.uk/api/v1
export GETH_LLM_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
export GETH_LLM_ALLOWED_MODELS="$GETH_LLM_MODEL"           # only models free to use on your ELM key
export GETH_LLM_API_KEY_VAR=ELM_API_KEY                    # export ELM_API_KEY=... in your shell profile

export PATH=$GETH_WORK_ROOT/nextflow/bin:$PATH             # where the nextflow launcher was installed
export GETH_NF_CONFIG=$GETH_HOME/site/examples/eddie.config
export GETH_NFCORE_PROFILE=roslin                          # nf-core/configs institutional profile
export NXF_SGE_PROJECT=<your_compute_project>              # read by the roslin profile (qsub -P)
export GETH_GPU=yes
export GETH_GPU_CONFIG=$GETH_HOME/site/examples/eddie-gpu.config
export GETH_JAVA17_HOME=/usr/lib/jvm/java-17-openjdk
export GETH_CONTAINER_CACHE=<shared_image_cache_or_empty>  # e.g. the roslin profile's apptainer cacheDir
export GETH_MODULES="java/jdk-21.0.1 apptainer/1.4.4"
export GETH_DRIVER_CPUS=2                                  # login nodes are shared: drivers stay small
export GETH_MAX_DRIVERS=2                                  # a plan uses 1 driver, a run 2: others wait
# Eddie allows agents only in sandboxes: their drivers run in a container (geth/bin/agent_sandbox.sh) that sees
# only the run, its data and the catalogue, and writes only the run folder, Nextflow's home and the image cache.
export GETH_AGENT_SANDBOX=yes
export GETH_AGENT_SANDBOX_RW=<shared_image_cache>            # the roslin profile's apptainer cacheDir
export GETH_AGENT_SANDBOX_RO=<shared_reference_data>         # read-only: shared databases (e.g. Kraken2) in the catalogue

# Optional paid planner model, opt-in per plan (geth plan ... --model sol): prices "input,cached input,output" in
# USD per million tokens, and the most one plan may spend. GPT-6 models need the Responses API for tools.
# export GETH_PLANNER_SOL_MODEL=gpt-6.1-sol
# export GETH_PLANNER_SOL_PRICES=2,0.2,10
# export GETH_PLANNER_SOL_BUDGET_USD=0.50
# export GETH_PLANNER_SOL_API=responses
# geth project: reference downloads as jobs on the staging queue (only GETH_HOME is passed: never the API key)
export GETH_DOWNLOAD_SUBMIT="qsub -sync y -q staging -P <your_compute_project> -cwd -j y -l h_rt=02:00:00 -v GETH_HOME=$GETH_HOME"
