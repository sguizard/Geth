// Free ELM models only — see GETH_ALLOWED_MODELS in Geth/env.sh.
params.model = 'Qwen/Qwen3.5-397B-A17B-FP8'

agent {
    runner         = 'langchain4j'
    apiProvider    = 'openai'
    baseUrl        = 'https://elm.edina.ac.uk/api/v1'
    apiKey         = System.getenv('ELM_API_KEY')
    requestTimeout = '300 sec'
}
